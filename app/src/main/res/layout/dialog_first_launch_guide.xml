<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_rounded_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Советы по использованию"
            android:textSize="38sp"
            android:textColor="@color/dialog_guide_title"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp" />

        <!-- 分隔线 -->
        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/dialog_guide_accent"
            android:layout_marginBottom="20dp" />

        <!-- 提示内容1 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="①"
                android:textSize="25sp"
                android:textColor="@color/dialog_guide_accent"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Перед использованием обязательно предоставьте приложению все необходимые разрешения и настройте модель автомобиля."
                android:textSize="25sp"
                android:textColor="@color/dialog_guide_content"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- 提示内容2 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="②"
                android:textSize="25sp"
                android:textColor="@color/dialog_guide_accent"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Если ваша модель не поддерживается, выберите пользовательскую модель и настройте вручную. Ошибки в этом режиме — нормальное явление."
                android:textSize="25sp"
                android:textColor="@color/dialog_guide_content"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- 提示内容3 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="③"
                android:textSize="25sp"
                android:textColor="@color/dialog_guide_accent"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Если видео не сохраняется, попробуйте изменить «Режим записи»."
                android:textSize="25sp"
                android:textColor="@color/dialog_guide_content"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- 提示内容4 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="④"
                android:textSize="25sp"
                android:textColor="@color/dialog_guide_accent"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="После установки или обновления при возникновении ошибок рекомендуется перезагрузить головное устройство!"
                android:textSize="25sp"
                android:textColor="@color/dialog_guide_content"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- 分隔线2 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dialog_guide_divider"
            android:layout_marginBottom="16dp" />

        <!-- 作者信息 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Автор ПО — @greenteacher46. Текущая версия бесплатная и с открытым кодом. При обнаружении коммерческого использования сообщите автору."
            android:textSize="20sp"
            android:textColor="@color/dialog_guide_secondary"
            android:lineSpacingExtra="3dp"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- 打赏支持 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Если проект вам полезен, вы можете поддержать автора!"
            android:textSize="20sp"
            android:textColor="@color/dialog_guide_accent"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- 二维码图片（尺寸在代码中根据屏幕密度动态设置） -->
        <ImageView
            android:id="@+id/iv_qrcode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:scaleType="fitCenter"
            android:contentDescription="QR-код для пожертвования"
            android:layout_marginBottom="20dp" />

        <!-- 确认按钮 -->
        <TextView
            android:id="@+id/btn_confirm"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/dialog_button_background"
            android:gravity="center"
            android:text="Понятно"
            android:textColor="@color/dialog_guide_button_text"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
